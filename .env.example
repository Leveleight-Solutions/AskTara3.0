# Copy to .env for local development. Keep actual credentials out of version control.
PORT=3001
DATABASE_PATH=./data/asktara.sqlite
APP_ORIGIN=http://localhost:5173

# Local HTTP development only. NODE_ENV=production always enables secure cookies,
# even when COOKIE_SECURE=false. Production must be served through HTTPS.
COOKIE_SECURE=false

# Set to 1 only behind exactly one trusted reverse proxy that sanitizes forwarded
# headers; otherwise leave 0. This affects client IP rate limits and HTTPS detection.
TRUST_PROXY=0
# Maximum graceful shutdown while dispatched supplier requests finish.
# Hosting SIGTERM-to-SIGKILL buffer must be at least 10 seconds longer.
SHUTDOWN_GRACE_MS=200000

# Optional. Without this key the curated local planner remains fully available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low

# Optional. Enable Places API (New) on a Google Cloud project. Keep this key server-side.
GOOGLE_PLACES_API_KEY=

# Optional public browser key: enable only Maps Embed API; restrict to website referrers.
# Use a separate key from the secret server Places key above. See docs/INTEGRATIONS.md.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional. Duffel test tokens begin duffel_test_; test results are labeled.
DUFFEL_ACCESS_TOKEN=

# Optional. Use one key for both LiteAPI flights and LiteAPI hotel/rate searches.
# For quick testing, `sand_` keys are treated as test mode.
LITEAPI_API_KEY=
# Optional. Some LiteAPI deployments provide a separate public key for client-side tooling.
LITEAPI_PUBLIC_KEY=
# provider is conservative when the response/key does not identify the environment.
# Values: provider, test, live. A sandbox response or test key always stays test.
LITEAPI_MODE=provider
# Sandbox flight confirmation also needs verified account credit/payment-bypass access.
# Keep disabled until the supplier setup and test reservation are explicitly approved.
LITEAPI_FLIGHT_BOOKING_ENABLED=false
